# ─────────────────────────────────────────────────────────
# UAAMS environment variables
#
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — nothing secret ever gets committed.
# This file only documents WHICH keys exist, never real values.
# ─────────────────────────────────────────────────────────

# Firebase client SDK config (project: uaams-1068e)
# These are NEXT_PUBLIC_ on purpose — the client SDK needs them in the browser.
# They identify the project but don't grant access; authorisation is enforced by
# firestore.rules / storage.rules, not by hiding these values.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only — NO NEXT_PUBLIC prefix, and that matters:
# these credentials bypass the security rules, so they must never reach the
# browser bundle). Values come from a service account key generated in the
# Firebase console. The private key keeps its \n characters — wrap it in quotes.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=""

# SMTP (server-only). Leave these EMPTY to run in simulated email mode — the
# email service then writes emailLogs records with deliveryStatus "simulated"
# instead of sending, which is how we demo the full decision→email flow
# without any SMTP account configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Document storage strategy — this single flag switches the whole document
# pipeline, no code changes:
#   dummy    = metadata-only records in Firestore, nothing uploaded anywhere
#              (Sprint 1 fallback; also how we avoid handling real passports)
#   emulator = real upload flow against the local Firebase emulator
#   live     = real Firebase Storage uploads (needs Blaze billing enabled)
NEXT_PUBLIC_STORAGE_MODE=dummy
